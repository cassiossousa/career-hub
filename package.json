{
  "name": "career-hub",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "author": {
    "name": "Cássio dos Santos Sousa"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cassiossousa/career-hub.git"
  },
  "homepage": "https://professional-portfolio-mu-gray.vercel.app/",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky || echo 'husky unavailable (e.g. Vercel install) - skipping git hooks setup'",
    "audit:deep": "node apps/professional-portfolio/scripts/audit-runtime.mjs",
    "build": "npm run build --workspace professional-portfolio",
    "check:fast": "oxlint --deny-warnings -D correctness -D suspicious . && biome check .",
    "fix:fast": "oxlint --fix --deny-warnings -D correctness -D suspicious . && biome check --write .",
    "check:types": "tsc -b",
    "check:dead": "knip",
    "check:bloat": "node apps/professional-portfolio/scripts/audit-react-bloat.mjs",
    "check:arch": "depcruise apps/professional-portfolio/src -c apps/professional-portfolio/.dependency-cruiser.cjs",
    "check:case": "node scripts/check-case-sensitivity.mjs",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "check:bundle": "node apps/professional-portfolio/scripts/audit-bundle-budget.mjs",
    "check:clones": "jscpd apps/professional-portfolio/src apps/professional-portfolio/e2e apps/professional-portfolio/scripts apps/job-tracker/src scripts --min-lines 5 --min-tokens 40 --reporters console --exit-code 1",
    "check:lighthouse": "node apps/professional-portfolio/scripts/lighthouse-run.mjs",
    "check:visual-baseline": "node apps/professional-portfolio/scripts/check-visual-baseline-drift.mjs",
    "check:mutate:diff": "node apps/professional-portfolio/scripts/check-mutation-diff.mjs",
    "check:mutate:core": "node apps/professional-portfolio/scripts/check-mutation-core.mjs",
    "fix:all": "npm run fix:fast && npm run lint:fix && npm run prettier && npm run verify:all",
    "verify:push": "npm run check:types && npm run check:case && npm run check:dead && npm run check:bloat && npm run check:arch && npm run check:clones && npm run build",
    "verify:all": "npm run check:fast && npm run prettier:check && npm run check:types && npm run lint && npm run check:case && npm run test:cov -- --runInBand && npm run build && npm run check:bundle && npm run check:dead && npm run check:bloat && npm run check:arch && npm run check:clones && npm run check:audit",
    "dev": "npm run dev --workspace professional-portfolio",
    "dev:job-tracker": "npm run dev --workspace job-tracker",
    "build:job-tracker": "npm run build --workspace job-tracker",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "start": "npm run start --workspace professional-portfolio",
    "sync:projects": "node scripts/sync-github-projects.mjs",
    "sync:projects:check": "node scripts/sync-github-projects.mjs --check",
    "test": "jest --config apps/professional-portfolio/jest.config.cjs",
    "test:e2e": "playwright test --config apps/professional-portfolio/playwright.config.ts",
    "test:cov": "jest --config apps/professional-portfolio/jest.config.cjs --coverage",
    "update:visual-baselines": "node apps/professional-portfolio/scripts/update-visual-baselines.mjs"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "11.0.9"
    },
    "qs": "6.17.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@biomejs/biome": "2.6.8",
    "@eslint-react/eslint-plugin": "5.30.4",
    "@lhci/cli": "0.16.1",
    "@memlab/api": "2.0.6",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@types/jest": "30.0.0",
    "dependency-cruiser": "18.8.0",
    "dotenv": "17.3.1",
    "eslint": "9.39.4",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-no-barrel-files": "2.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.2.0",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "fast-check": "4.10.2",
    "gray-matter": "4.0.3",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "30.3.0",
    "jscpd": "5.4.3",
    "knip": "6.45.1",
    "lint-staged": "17.6.1",
    "oxlint": "1.94.0",
    "prettier": "3.8.1",
    "ts-jest": "29.4.15",
    "type-fest": "6.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
