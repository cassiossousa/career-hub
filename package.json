{
  "name": "professional-portfolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "author": {
    "name": "Cássio dos Santos Sousa"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cassiossousa/professional-portfolio.git"
  },
  "homepage": "https://professional-portfolio-mu-gray.vercel.app/",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @portfolio/web",
    "check:fast": "oxlint --deny-warnings -D correctness -D suspicious apps/web/src scripts/check-mutation-diff.mjs stryker.config.mjs && biome check apps/web/src scripts/check-mutation-diff.mjs stryker.config.mjs",
    "check:types": "tsc -b",
    "check:dead": "knip",
    "check:arch": "depcruise apps/web/src --validate .dependency-cruiser.cjs",
    "check:mutate:diff": "node scripts/check-mutation-diff.mjs",
    "verify:all": "npm run check:fast && npm run prettier:check && npm run check:types && npm run lint && npm test -- --runInBand && npm run build && npm run check:dead && npm run check:arch",
    "dev": "npm run dev --workspace @portfolio/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "start": "npm run start --workspace @portfolio/web",
    "sync:projects": "node scripts/sync-github-projects.mjs",
    "test": "jest",
    "test-cov": "jest --coverage",
    "ts:prune": "npx knip --include exports,types,nsExports,nsTypes",
    "ts:unused-exports": "npx knip --include exports,types,nsExports,nsTypes",
    "tsc": "tsc -b",
    "unimported": "npx knip --production --dependencies --files"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "11.0.9"
    },
    "qs": "6.17.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@biomejs/biome": "2.6.8",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@types/jest": "30.0.0",
    "dependency-cruiser": "18.8.0",
    "dotenv": "17.3.1",
    "eslint": "9.39.4",
    "gray-matter": "4.0.3",
    "jest": "29.7.0",
    "jest-environment-jsdom": "30.3.0",
    "knip": "6.45.1",
    "oxlint": "1.94.0",
    "prettier": "3.8.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
