# Copy this file to .env.local and fill in real values.
# EVERYTHING below is fake placeholder data — do not use it anywhere real.

# Backend origin the Vite dev server proxies /api/* requests to.
# Only used by `vite` and `vite preview` (Node side, not shipped to the browser).
API_PROXY_TARGET=http://127.0.0.1:8000

# Absolute API base URL. Leave unset for local dev: requests stay same-origin
# and go through the dev proxy, so no CORS is needed. Set this only when the
# frontend is deployed separately from the API.
# VITE_API_URL=https://api.example.invalid

# Bearer token sent as `Authorization: Bearer <key>` on every API request.
# Must match API_KEY on the backend. This value is NOT a real key.
VITE_API_KEY=xxxxxxxxxx-FAKE-FAKE-FAKE-not-a-real-key-0123456789-abcdefghij

# MSW mock data in local dev. Default: enabled ("true").
# Set to "false" to hit the real API. In dev builds you can also flip this
# at runtime from the sidebar ("Mock data") — the choice persists in
# localStorage and wins over this variable.
# VITE_MOCK_API=false
