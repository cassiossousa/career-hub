{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignore": ["scripts/context-hook.mjs"],
      "ignoreDependencies": [
        "@lhci/cli",
        "@secretlint/secretlint-rule-preset-recommend",
        "source-map-explorer"
      ]
    },
    "apps/professional-portfolio": {
      "entry": [
        "scripts/memlab-run.mjs",
        "scripts/memlab-portfolio.cjs",
        "stryker.core.config.mjs"
      ]
    },
    "apps/job-tracker": {
      "entry": [
        "src/test/**/*.{ts,tsx}",
        "stryker.core.config.mjs",
        "scripts/*.mjs"
      ],
      "ignore": [
        "public/mockServiceWorker.js",
        "src/services/api/generated/**"
      ],
      "ignoreDependencies": ["openapi-typescript"]
    },
    "packages/ui": {
      "entry": ["stryker.core.config.mjs"]
    }
  }
}
