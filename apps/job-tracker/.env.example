# Copy this file to .env.local and fill in real values.
# EVERYTHING below is fake placeholder data — do not use it anywhere real.
# Real values live in .env.local / .env.production.local (gitignored via
# .env* rules) locally, and in the Vercel project's dashboard env vars
# for deployed builds — never commit them.

# Backend origin the Vite dev server proxies /api/* requests to.
# Only used by `vite` and `vite preview` (Node side, not shipped to the browser).
API_PROXY_TARGET=http://127.0.0.1:8000

# Absolute API base URL. Leave unset for local dev: requests stay same-origin
# and go through the dev proxy, so no CORS is needed. REQUIRED for deployed
# builds — set it in the Vercel project's env vars (Production + Preview).
# VITE_API_URL=https://api.example.invalid

# Bearer token sent as `Authorization: Bearer <key>` on every API request.
# Must match API_KEY on the backend. This value is NOT a real key.
#
# SECURITY: VITE_* values are inlined into the public JS bundle — anyone who
# loads a live-mode deployment can extract this key. Live mode is only
# acceptable behind Vercel Deployment Protection → Vercel Authentication →
# "All Deployments". NEVER enable live mode on a public deployment.
# VITE_API_KEY=xxxxxxxxxx-FAKE-FAKE-FAKE-not-a-real-key-0123456789-abcdefghij

# Data mode.
#
# Local dev (`vite`): mock data is ON by default; set VITE_MOCK_API=false to
# hit the real API through the dev proxy (see API_PROXY_TARGET above). You can
# also flip this at runtime from the sidebar ("Mock data") — the choice
# persists in localStorage.
#
# Production builds: the app runs in DEMO mode by default — MSW serves
# fabricated data and every /api/* request without a mock handler fails as a
# network error, so the real API is unreachable even if VITE_API_URL/KEY are
# set. To opt into LIVE mode (real API) you must set ALL of:
#   VITE_DATA_MODE=live, VITE_API_URL, VITE_API_KEY
# and keep Vercel Deployment Protection enabled — the key is extractable from
# the public bundle. Anything missing falls back to demo.
# VITE_DATA_MODE=live
