# professional-portfolio environment variables
#
# Real values live in .env.local / .env.production.local (gitignored via
# .env* rules) locally, and in the Vercel project's dashboard env vars for
# deployed builds — never commit them.

# Backend origin the Vite dev server proxies /api/* requests to.
# Only used by `vite` and `vite preview` (Node side, not shipped to the browser).
# Defaults to http://localhost:8000 (local job-tracker-api) when unset.
# API_PROXY_TARGET=http://127.0.0.1:8000

# Absolute API base URL for the job-tracker API. Leave unset for local dev:
# requests stay same-origin and go through the dev proxy, so no CORS is needed.
# REQUIRED only if you bypass the proxy — e.g. calling the API cross-origin
# from a deployed build WITHOUT the vercel.json /api rewrite. The deployed
# site proxies /api/* same-origin via vercel.json, so this can stay unset.
# VITE_API_URL=https://api.example.invalid
