{
  "name": "professional-portfolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "author": {
    "name": "Cássio dos Santos Sousa"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cassiossousa/professional-portfolio.git"
  },
  "homepage": "https://professional-portfolio-mu-gray.vercel.app/",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier-check": "prettier --check .",
    "start": "vite preview",
    "sync-projects": "node scripts/sync-github-projects.mjs",
    "test": "jest",
    "test-cov": "jest --coverage",
    "ts-prune": "npx knip --include exports,types,nsExports,nsTypes",
    "ts-unused-exports": "npx knip --include exports,types,nsExports,nsTypes",
    "tsc": "tsc --noEmit",
    "unimported": "npx knip --production --dependencies --files"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "@tailwindcss/typography": "0.5.19",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.3.1",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.37",
    "@types/react": "18.3.28",
    "autoprefixer": "10.4.27",
    "dotenv": "17.3.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "jest-environment-jsdom": "30.3.0",
    "jiti": "2.6.1",
    "postcss": "8.5.8",
    "prettier": "3.8.1",
    "tailwindcss": "3.4.19",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "vite": "6.4.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0"
  }
}
